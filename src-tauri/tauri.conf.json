{
  "$schema": "https://raw.githubusercontent.com/nicholasrice/tauri/next/packages/tauri-utils/schema.json",
  "productName": "Spine Companion",
  "version": "0.1.3",
  "identifier": "dev.spine-companion.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:17389",
    "beforeDevCommand": "bun run dev:renderer",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Spine Companion",
        "width": 360,
        "height": 460,
        "minWidth": 260,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": false,
        "shadow": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Spine Companion"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
