{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allow the main, manager and panel windows to use Tauri core IPC APIs.",
  "windows": ["main", "manager", "panel"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-outer-position",
    "shell:default"
  ]
}
