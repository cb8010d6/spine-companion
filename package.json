{
  "name": "spine-companion",
  "version": "0.2.6-rc.11",
  "description": "Spine-powered AI coding companion that turns agent activity into an animated desktop character.",
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "author": {
    "name": "Spine Companion contributors",
    "email": "spine-companion@users.noreply.github.com"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --host 127.0.0.1 --port 17389",
    "dev:api": "bun scripts/dev-api.cjs",
    "build": "vite build",
    "release:win": "tauri build --bundles nsis",
    "release:linux": "tauri build --bundles deb,appimage",
    "release:mac": "tauri build --bundles app,dmg",
    "start": "tauri dev",
    "setup:assets": "bun scripts/setup-local-assets.cjs",
    "mcp:server": "bun scripts/mcp-companion-server.mjs",
    "mcp:install:codex": "bun scripts/install-codex-mcp.cjs",
    "status:report": "bun scripts/report-status.cjs",
    "ai:configure": "bun skills/spine-companion-status/scripts/configure-ai-tools.cjs --repo .",
    "skill:install": "bun scripts/install-status-skill.cjs",
    "check:mcp": "bun scripts/check-mcp-bridge.mjs",
    "check:mcp:packaged": "bun scripts/check-packaged-mcp.mjs",
    "check": "bun scripts/check-project.cjs",
    "lint": "eslint src scripts tests *.mjs",
    "type-check": "tsc --project jsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "tauri:dev": "tauri dev",
    "tauri:build": "bun scripts/tauri-build.cjs",
    "tauri:portable:assets": "bun scripts/package-tauri-portable.cjs",
    "release:preflight": "bun scripts/release-preflight.mjs",
    "release:checksums": "bun scripts/generate-sha256sums.mjs",
    "catalog:generate:illustrations": "bun scripts/generate-ark-catalog.mjs --source catalog/ark-illustrations-source.json --output catalog/illustrations.json",
    "catalog:generate:enemies": "bun scripts/generate-ark-catalog.mjs --source catalog/ark-enemies-source.json --output catalog/enemies.json",
    "catalog:audit": "bun scripts/audit-model-catalog.mjs --sample-rate 0.01"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pixi-spine/runtime-3.8": "3.1.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "lucide": "^1.24.0",
    "pixi-spine": "3.1.2",
    "pixi.js": "6.5.10",
    "ws": "8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "22.19.11",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "happy-dom": "^20.0.11",
    "typescript": "5.9.3",
    "vite": "6.2.4",
    "vitest": "^4.1.5"
  }
}
